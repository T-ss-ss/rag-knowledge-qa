# DeepSeek Chat
DEEPSEEK_API_KEY=your-deepseek-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
CHAT_MODEL=deepseek-chat

# Qwen Embedding
EMBEDDING_API_KEY=your-dashscope-key
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=text-embedding-v3

# Database & Storage
SQLITE_DB_PATH=./data/app.db
CHROMA_PERSIST_DIR=./chroma_data

# Chunking
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
MAX_FILE_SIZE_MB=50

# Retrieval
DEFAULT_TOP_K=4
EMBEDDING_BATCH_SIZE=10
# 混合检索：向量 + BM25 经 RRF 融合。
# 评测（eval/results/metrics.json）显示 Recall@4 0.677 → 0.745，代价是 +
# 23ms；故默认开启。设为 false 可退回纯向量检索。
HYBRID_ENABLED=true
# RRF 平滑常数（原论文取 60）
RRF_K=60

# Rerank (BGE Reranker, download on first use ~2.3 GB)
# 设为 true 启用精排；保持 false 时 RerankerService 不会被加载。
#
# 注意成本：评测显示 Recall@4 0.677 → 0.781（+15.4%），但**纯 CPU 单次 query
# 约 21.7 秒**（12 条候选逐对过 Cross-encoder）。CPU 环境建议保持 false，
# 否则每次问答都要等 20 秒以上；有 GPU 时约 0.2 秒量级才值得开启。
RERANK_ENABLED=false
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RETRIEVAL_MULTIPLIER=3
# 权重缓存目录；相对路径按【项目根】解析，默认落在项目内 ./models
# （本地直跑与 Docker 的 HF_HOME=/app/models 指向同一目录）
RERANKER_CACHE_DIR=./models
# HuggingFace 下载端点；国内网络建议保留镜像，留空则走官方 huggingface.co
HF_ENDPOINT=https://hf-mirror.com

# Agent
AGENT_MAX_ITERATIONS=5

# Tavily Web Search (optional, leave empty to disable)
TAVILY_API_KEY=
